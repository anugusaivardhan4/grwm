# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard → your project → Project Settings → API Keys (and Data API for the URL).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_...). Safe to use in the browser.
# If your project only shows the legacy "anon public" key, you can paste that here instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address your site runs on. Used in sign-up confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
